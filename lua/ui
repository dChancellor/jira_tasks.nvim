local M = {}

local utils = require("get-jira-tasks.utils")

vim.cmd("highlight HeaderText gui=bold guifg=#fff")
vim.cmd("highlight SubText guifg=#aaaaaa")

local under_review_symbol = "🟢"
local in_progress_symbol = "🔵"
local other_symbol = "⚪"
local indent = "  "

function M.create_ticket_window(issue)
  local title =
    { { M.get_ticket_status_symbol(issue.fields.status) }, { " " }, { issue.key }, { ": " }, { issue.fields.summary } }
  local buf, win = utils.create_floating_window({
    title = title,
    width = 100,
    height = 40,
  })
  vim.api.nvim_set_option_value("wrap", true, { win = win })
  vim.api.nvim_set_option_value("linebreak", true, { win = win })
  vim.api.nvim_set_option_value("breakindent", true, { win = win })

  local description = utils.traverse_description(issue.fields.description.content)

  M.create_ticket_section(buf, "Description", description)
end

function M.set_highlight(bufnr, line, group)
  local ns_id = vim.api.nvim_create_namespace("get-jira-tasks")
  vim.api.nvim_buf_add_highlight(bufnr, ns_id, group, line, 0, -1)
end

function M.create_ticket_section(buf, header, text)
  -- Overwrites first line from new buffer
  if vim.api.nvim_buf_line_count(buf) == 1 then
    vim.api.nvim_buf_set_lines(buf, 0, -1, false, { header, "=========" })
  else
    vim.api.nvim_buf_set_lines(buf, -1, -1, false, { header, "=========" })
  end

  local buf_length = vim.api.nvim_buf_line_count(buf)
  M.set_highlight(buf, buf_length - 1, "HeaderText")
  M.set_highlight(buf, buf_length - 2, "HeaderText")

  if type(text) == "string" then
    vim.api.nvim_buf_set_lines(buf, -1, -1, false, { indent .. text, "" })
    M.set_highlight(buf, buf_length, "SubText")
  elseif type(text) == "table" then
    for i, line in ipairs(text) do
      vim.api.nvim_buf_set_lines(buf, -1, -1, false, { indent .. line })
      M.set_highlight(buf, buf_length + (i - 1), "SubText")
    end
  end
end

function M.get_ticket_status_symbol(status)
  if status == "In Progress" then
    return in_progress_symbol
  elseif status == "Under Review" then
    return under_review_symbol
  else
    return other_symbol
  end
end

-- Debug Area
local issues = utils.read_local_json("./cached_tasks.txt")
M.create_ticket_window(issues.issues[2])
-- End Debug Area

return M
